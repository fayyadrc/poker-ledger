# Copy this file to .env and fill in the values below.
# This one file covers both the Django backend and the Vite frontend
# (vite.config.js points its envDir at the repo root, so it reads this
# same file — only VITE_-prefixed keys are exposed to browser code).

# ── Backend (Django) ───────────────────────────────────────────────────────
SECRET_KEY=replace_me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Where users return after social login (Vite dev server or production app URL)
FRONTEND_URL=http://127.0.0.1:5173

# Comma-separated list. Include both localhost and 127.0.0.1 if you use either in the browser.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production / Docker — Postgres connection string
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Redis — API response cache (optional)
# REDIS_URL=redis://127.0.0.1:6379/0
# CACHE_TTL=300

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# Optional — only when the frontend cannot use the Vite proxy or same-origin /api
# VITE_API_URL=http://127.0.0.1:8000/api

# ── Supabase Auth ────────────────────────────────────────────────────────────
# Backend: verifies the SPA's Supabase access token (a Bearer JWT). Check
# Supabase → Project Settings → API → JWT Settings to see which signing
# method your project uses — it's one or the other, not both:
#
#   - Asymmetric (ES256, current default for new projects): set SUPABASE_URL
#     so the backend can fetch the public key from the project's JWKS
#     endpoint. Takes priority over SUPABASE_JWT_SECRET when both are set.
SUPABASE_URL=https://your-project-ref.supabase.co
#
#   - Legacy shared secret (HS256): set SUPABASE_JWT_SECRET instead. Find it
#     under JWT Settings → "JWT Secret (legacy)". KEEP THIS SERVER-SIDE ONLY.
# SUPABASE_JWT_SECRET=replace_me
#
# The audience Supabase stamps on user access tokens (almost always this).
# SUPABASE_JWT_AUD=authenticated
#
# See SUPABASE_AUTH_SETUP.md for the full walkthrough.

# Frontend: the SPA logs in against Supabase with these. From:
#   Supabase → Project Settings → API → "Legacy anon, service_role API keys".
# The anon (public) key is safe to ship to the browser — it only grants what
# RLS/Supabase Auth allow. Must be the SAME project as SUPABASE_JWT_SECRET
# above. Never put the service_role key here or anywhere frontend-facing.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace_me
